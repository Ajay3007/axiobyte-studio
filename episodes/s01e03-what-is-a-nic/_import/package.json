{
  "name": "nic-3d",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive procedural 3D Network Interface Card built with Three.js (AxioByte visualization engine)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "video": "npm run audio && vite --open /video.html",
    "build": "vite build",
    "preview": "vite preview",
    "render": "node scripts/render.mjs",
    "render:a": "node scripts/render.mjs --from 0 --to 0:32 --out final/preview-a.mp4",
    "render:b": "node scripts/render.mjs --from 6:15 --to 8:45 --out final/preview-b.mp4",
    "stills": "node scripts/render.mjs --stills 0:04,0:26,1:30,2:35,3:00,3:35,4:05,4:40,6:30,6:50,7:15,8:00,9:40,10:30,11:45",
    "audio": "node scripts/prepare-audio.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "sheet": "node scripts/render.mjs --sheet auto"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.1"
  }
}
